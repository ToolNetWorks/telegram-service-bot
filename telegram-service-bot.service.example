[Unit]
Description=ToolNet Telegram Service Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/telegram-service-bot
ExecStart=/usr/bin/python3 /home/ubuntu/telegram-service-bot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/telegram-service-bot/data

[Install]
WantedBy=multi-user.target
