# Engagement API Environment Variables
# Copy this file to .env for local development
# DO NOT commit .env files to git

# Service Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Internal Authentication (REQUIRED)
# Must match ENGAGEMENT_API_TOKEN in Bot Core
ENGAGEMENT_INTERNAL_TOKEN=shared-internal-token-change-in-production

# Database Configuration (Turso)
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_TOKEN=your-turso-auth-token
# For local development with SQLite, leave empty:
DATABASE_URL=
DATABASE_TOKEN=

# Provider API Credentials (REQUIRED for production)
# Get from VietnamFB panel
VIETNAMFB_API_KEY=your-vietnamfb-api-key
VIETNAMFB_BASE_URL=https://vietnamfb.com

# Security Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO