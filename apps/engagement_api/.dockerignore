# Docker ignore for Engagement API
# Prevents copying unnecessary files to Docker image

# Environment files
.env
.env.*
!.env.example

# Local data
data/
*.sqlite3*
*.db

# Backups
backups/
*.bak

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation
README.md
CHANGELOG.md

# Tests
tests/
*.test.py
*_test.py
pytest.ini
coverage/
htmlcov/
.coverage

# Logs
*.log

# OS
.DS_Store
Thumbs.db