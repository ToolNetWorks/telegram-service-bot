# Bot Core Environment Variables
# Copy this file to .env for local development
# DO NOT commit .env files to git

# Telegram Bot Configuration (REQUIRED)
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=123456789

# Bot Identity
BOT_NAME=ToolNet Services
SUPPORT_USERNAME=support

# Database Configuration
# For Turso (production): DB_BACKEND=turso, TURSO_URL=..., TURSO_TOKEN=...
# For SQLite (development): DB_BACKEND=sqlite, DB_PATH=./data/bot.sqlite3
DB_BACKEND=sqlite
DB_PATH=./data/bot.sqlite3

# Turso (Production) - Required when DB_BACKEND=turso
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_TOKEN=your-turso-auth-token

# Banking Information (for deposits)
BANK_NAME=Your Bank Name
BANK_ACCOUNT=1234567890
BANK_OWNER=Account Holder Name

# Engagement API Connection
# The token must match ENGAGEMENT_INTERNAL_TOKEN on the Engagement API.
# Do NOT add VIETNAMFB_API_KEY or VIETNAMFB_BASE_URL here: provider
# credentials belong only to the Engagement API service.
ENGAGEMENT_API_URL=http://localhost:8000
ENGAGEMENT_API_TOKEN=shared-internal-token-change-in-production

# Logging
LOG_LEVEL=INFO