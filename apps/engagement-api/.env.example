# Engagement API Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env files.

# Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Internal authentication (REQUIRED, must match ENGAGEMENT_API_TOKEN in Bot Core)
ENGAGEMENT_INTERNAL_TOKEN=change-me-in-production

# VietnamFB provider (REQUIRED in production)
VIETNAMFB_API_KEY=
VIETNAMFB_BASE_URL=https://vietnamfb.com

# Provider transport / limits
REQUEST_TIMEOUT=20
CONNECT_TIMEOUT=5
MAX_RETRIES=2
PROVIDER_CACHE_TTL=300
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# NOTE: The Engagement API is stateless. Do NOT add TURSO_URL/TURSO_TOKEN or
# DATABASE_URL/DATABASE_TOKEN here. Durable orders/idempotency belong to Bot Core.
